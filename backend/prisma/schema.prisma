
generator client {
  provider = "prisma-client-js"

}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model User {
  id          String   @id @default(uuid())
  name        String
  email       String      @unique
  password    String
  createdAt   DateTime  @default(now())
  playlists    Playlist[]
  songs        Song[]

}

model Playlist {
  id          String     @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  userId      String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  songs       Song[]

  @@index([userId])
  @@unique([userId, name])
}

model Song {
  id          String     @id @default(uuid())
  name        String
  artist      String
  album       String
  yearPublish Int
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  userId      String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  playlists   Playlist[]

  @@index([userId])
}